# ==============================================================================
# AURA - Pure Python AI Personal Assistant Configuration
# ==============================================================================

# Assistant Identity
AURA_ASSISTANT_NAME=AURA

# AI Providers Configuration
# Available modes: automatic (prefers offline Ollama, falls back to online with alert), offline, online
AI_DEFAULT_MODE=automatic

# Offline Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Online AI Configuration (OpenAI-compatible endpoints or custom APIs)
ONLINE_API_KEY=
ONLINE_API_BASE_URL=https://api.openai.com/v1
ONLINE_MODEL_NAME=gpt-4o-mini

# Voice & Speech Configuration
VOICE_ENABLED=true
SPEECH_RATE=175
SPEECH_VOLUME=1.0

# Accessibility & Visual Performance
REDUCED_MOTION=false

# Controlled Windows Automation
AUTOMATION_ENABLED=true
AUTOMATION_REQUIRE_CONFIRMATION=true

# Storage (optional: leave empty for standard user AppData directory)
AURA_DATA_DIR=
